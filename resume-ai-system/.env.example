# Used by docker-compose. Copy to .env and fill in your keys.
# All values default to demo-mode-friendly settings.

# LLM provider
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub verification (recommended — raises rate limit 60→5000/hr)
GITHUB_TOKEN=

# Auth — leave both BYPASS flags true for the demo
DEV_BYPASS_AUTH=true
VITE_BYPASS_AUTH=true
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
