# Get from https://dashboard.clerk.com — Application → API Keys → Publishable
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API base URL. Leave empty in dev to use Vite's proxy.
VITE_API_BASE_URL=

# Set to "true" to bypass Clerk login on the frontend (for demo/screen-recording)
VITE_BYPASS_AUTH=true
