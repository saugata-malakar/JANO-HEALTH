# LLM Provider — at least one is required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Which provider to default to: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
EMBEDDING_MODEL=local  # "local" uses sentence-transformers; "openai" uses text-embedding-3-small

# Verification Engine
GITHUB_TOKEN=ghp_...   # optional but strongly recommended (raises rate limit 60→5000/hr)

# Clerk JWT verification (paste your Clerk JWKS URL — found in Clerk Dashboard → API Keys)
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Disable auth for local dev (NEVER set this in prod)
DEV_BYPASS_AUTH=true

# Cache
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
